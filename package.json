{
  "name": "rimr-workspace",
  "private": true,
  "description": "A RimWorld mod manager.",
  "author": "Rhynia",
  "license": "GPL-3.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "tauri": "pnpm --filter rimr tauri",
    "dev": "pnpm --filter rimr dev",
    "bindings": "cargo run --locked -p xtask -- export-bindings",
    "bindings:check": "cargo run --locked -p xtask -- export-bindings --check",
    "build": "pnpm --filter rimr build",
    "build:assets": "pnpm --filter rimr build:assets",
    "build:bin": "pnpm --filter rimr build:bin",
    "bundle": "node .github/scripts/build.mjs",
    "typecheck": "pnpm --filter rimr typecheck",
    "lint": "oxlint . --deny-warnings --report-unused-disable-directives",
    "fmt": "oxfmt --write . && pnpm docs:fix",
    "fmt:check": "oxfmt --check . && pnpm docs:check",
    "test": "pnpm --filter rimr test",
    "release": "cargo run --locked -p xtask -- release",
    "ci:test": "node --test .github/scripts/ci.test.mjs .github/scripts/native-packages.test.mjs",
    "check": "pnpm ci:test && pnpm bindings:check && pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm build:assets && pnpm test && pnpm rust:check && pnpm rust:fmt:check && pnpm rust:lint && pnpm rust:test",
    "lint:fix": "pnpm lint --fix",
    "docs:fix": "rumdl check --fix --deny-config-warnings",
    "docs:check": "rumdl check --deny-config-warnings",
    "rust:check": "cargo check --workspace --locked",
    "rust:fmt": "cargo dev format --locked",
    "rust:fmt:check": "cargo dev format --check --diff --locked",
    "rust:lint": "cargo dev lint --locked",
    "rust:test": "cargo test --workspace --locked"
  },
  "devDependencies": {
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "rumdl": "^0.3.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
