{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "es2020": true
  },
  "ignorePatterns": ["app/src/commands/generated/**", "app/src-tauri/gen/**"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-key": "error",
    "react/jsx-no-undef": "error",
    "react/jsx-no-useless-fragment": "error",
    "react/self-closing-comp": "error",
    "react/no-unstable-nested-components": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/valid-expect": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "zustand",
            "message": "zustand stores must live in app/src/stores/. See docs/development.md#前端状态归属."
          }
        ]
      }
    ],
    "max-lines": [
      "error",
      {
        "max": 300,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 80,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react/preserve-manual-memoization": "off",
    "react/incompatible-library": "off",
    "react/use-memo": "off"
  },
  "overrides": [
    {
      "files": ["app/src/**"],
      "env": {
        "browser": true
      }
    },
    {
      "files": ["app/src/domain/**", "app/src/features/*/model/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "model/ must stay pure: do not import React or state libraries here. See docs/development.md#前端状态归属."
              },
              {
                "name": "react-dom",
                "message": "model/ must stay pure: do not import React or state libraries here. See docs/development.md#前端状态归属."
              },
              {
                "name": "zustand",
                "message": "model/ must stay pure: do not import React or state libraries here. See docs/development.md#前端状态归属."
              },
              {
                "name": "@tanstack/react-query",
                "message": "model/ must stay pure: do not import React or state libraries here. See docs/development.md#前端状态归属."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["app/src/stores/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 350,
            "skipBlankLines": true,
            "skipComments": true
          }
        ],
        "max-lines-per-function": [
          "error",
          {
            "max": 120,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": ["app/vite.config.ts", "app/vitest.config.ts", "scripts/**/*.ts"],
      "env": {
        "node": true
      }
    }
  ]
}
