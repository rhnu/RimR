{
  "name": "rimr-workspace",
  "private": true,
  "version": "0.2.2",
  "description": "A RimWorld mod manager.",
  "author": "Rhynia",
  "license": "GPL-3.0",
  "type": "module",
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "scripts": {
    "tauri": "pnpm --filter rimr tauri",
    "dev": "pnpm --filter rimr dev",
    "bindings": "cargo run -p xtask -- export-bindings",
    "bindings:check": "cargo run -p xtask -- export-bindings --check",
    "build": "pnpm --filter rimr build",
    "build:bin": "pnpm --filter rimr build:bin",
    "typecheck": "pnpm --filter rimr typecheck && tsc --noEmit -p tsconfig.node.json --pretty false",
    "lint": "pnpm --filter rimr lint",
    "fmt": "pnpm --filter rimr fmt",
    "fmt:check": "pnpm --filter rimr fmt:check",
    "test": "pnpm --filter rimr test",
    "bump": "tsx scripts/bump-version.ts",
    "check": "pnpm bindings:check && pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test && cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "semver": "^7.8.5",
    "@types/semver": "^7.7.1",
    "@types/node": "^24.0.14",
    "typescript": "~5.8.3"
  }
}
