{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RimR",
  "mainBinaryName": "RimR",
  "identifier": "org.rhynia.rimr",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RimR",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "copyright": "Copyright (C) 2026 Rhynia. Licensed under the GNU General Public License v3.",
    "publisher": "Rhynia",
    "license": "GPL-3.0",
    "licenseFile": "../../LICENSE",
    "shortDescription": "A RimWorld mod manager.",
    "longDescription": "RimR is a desktop mod manager for RimWorld.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2REE4RUJEMjQwQkYzNDgKUldSSTh3c2t2WTdhOWdmVmZ4U3hnVDJML2NiRFNpQ2k4bVl5dkk5aC81TzR6em1kVitBWlhOWTMK",
      "endpoints": ["https://github.com/rhnu/rimr/releases/latest/download/latest.json"]
    }
  }
}
